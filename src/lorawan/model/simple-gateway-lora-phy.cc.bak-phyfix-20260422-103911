// SX1272 end-device sensitivity (dBm) for SF7..SF12 @ BW=125kHz
// Source: Semtech SX1272/73 datasheet, Table 10, Rev 3.1, March 2017
// Chosen to match FLoRa framework (Pueyo-Centelles 2024 paper), which uses the
// same SX1272 values in src/LoRaPhy/LoRaReceiver.cc. Shadows GatewayLoraPhy::
// sensitivity (SX1301 concentrator values) which is inappropriate for
// peer-to-peer mesh. See also end-device-lora-phy.cc for identical table.
const double ns3::lorawan::SimpleGatewayLoraPhy::sensitivity[6] =
    {-124.0, -127.0, -130.0, -133.0, -135.0, -137.0};

